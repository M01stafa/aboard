# Aboard — environment variables (placeholders only; never commit real values)
# Copy to apps/web/.env.local for development. Full table: docs/specs/setup-and-deploy.md §5.5
#
# Everything with NEXT_PUBLIC_ is inlined into the browser bundle and is PUBLIC.
# Never put a secret in a NEXT_PUBLIC_ variable.

# --- Web app (public) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<oauth-client-id>.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_API_KEY=<picker-api-key-restricted-to-picker-api-and-referrers>
NEXT_PUBLIC_GOOGLE_APP_ID=<google-cloud-project-number>
NEXT_PUBLIC_PDF_API_URL=https://api.<domain>/pdf

# --- Supabase Edge Function secrets (set with `supabase secrets set`, NOT in this file's real copy) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TOKEN_ENC_KEY=            # openssl rand -base64 32
# APP_URL=https://<domain>
# APP_ORIGINS=https://<domain>,http://localhost:3000
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase; never copy them anywhere else.

# --- pdf-gateway (server env on the VPS) ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# STIRLING_URL=http://stirling:8080
# ALLOWED_ORIGINS=https://<domain>
# MAX_UPLOAD_MB=50
