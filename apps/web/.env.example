# Supabase project URL (public by design; access controlled via Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon / publishable key (public by design; grants only anon role with no table access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google OAuth Web Client ID for user sign-in and Google Picker authentication
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<oauth-client-id>.apps.googleusercontent.com

# Google Picker API key (restricted in Google Cloud Console to Picker API and authorized domains)
NEXT_PUBLIC_GOOGLE_API_KEY=AIzaSy...

# Google Cloud project number used as the Picker Application ID
NEXT_PUBLIC_GOOGLE_APP_ID=123456789012

# Stirling-PDF gateway endpoint URL (Task 40 / Phase 9)
NEXT_PUBLIC_PDF_API_URL=http://localhost/pdf

# Cloudflare Turnstile public site key for CAPTCHA bot protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<cloudflare-turnstile-site-key>
